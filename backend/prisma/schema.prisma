// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma" // Add this line
}

datasource db {
  provider = "sqlite"
  // url is now removed -- it lives in prisma.config.ts
}
model WishlistItem {
  id          String   @id @default(uuid())
  movieId     Int      @unique
  title       String
  overview    String
  posterUrl   String?
  backdropUrl String?
  rating      Float
  releaseDate String?
  createdAt   DateTime @default(now())
}